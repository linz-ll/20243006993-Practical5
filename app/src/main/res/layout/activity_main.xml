<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_default_background"
    tools:context=".MainActivity">

    <!-- Page title -->
    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/municipality_tianjin"
        android:text="@string/municipalities_title"
        android:textColor="@color/color_text_light"
        android:textSize="22sp"
        android:gravity="center"
        android:padding="8dp" />

    <!-- Map of Chinese municipalities -->
    <ImageView
        android:id="@+id/municipalitiesImageView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:layout_margin="16dp"
        android:src="@drawable/chinese_municipalities"
        android:scaleType="fitCenter"
        android:contentDescription="@string/map_description" />

    <!-- Municipality input section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/inputLabelTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/municipality_prompt"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_dark"
            android:labelFor="@id/municipalityInput" />

        <EditText
            android:id="@+id/municipalityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/municipality_hint"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:textSize="16sp"
            android:textColor="@color/color_text_dark" />

    </LinearLayout>

</LinearLayout>
